{
    "height": 43,
    "spacing": 20,
    "margin-top": 15,
    "margin-left": 25,
    "margin-right": 25,
    "margin-bottom": -15,
    "modules-left": [
        "hyprland/workspaces",
    ],
    "modules-center": [
        "clock",
    ],
    "modules-right": [
        "memory",
        "disk",
        "pulseaudio",
        "network",
        "cpu",
        "temperature",
        "tray",
    ],
     "hyprland/workspaces": {
         "disable-scroll": false,
         "all-outputs": false,
         "warp-on-scroll": false,
         "format": ""
     },
    "tray": {
        "spacing": 10,
    },
    "clock": {
        "format-alt": "{:%d-%m-%Y}"
    },
    "cpu": {
        "format": "{usage}% <span color=\"#000000\"> </span>",
        "tooltip": true,
        "interval": 1,
    },
    "temperature": {
        // k10temp Tctl; the hwmon* index is not stable across reboots, so match on the device path
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "interval": 1,
        "critical-threshold": 85,
        "format": "{temperatureC}°C <span color=\"#000000\">󰔏</span>",
        "tooltip-format": "CPU: {temperatureC}°C ({temperatureF}°F)",
    },
    "memory": {
        "format": "{used:0.1f}/{total:0.1f} GiB <span color=\"#000000\"> </span>",
        "interval": 1,
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{signalStrength}% <span color=\"#000000\">󰖩</span>",
        "format-ethernet": "{ifname} 󰈁",
        "tooltip-format": "{ifname} via {gwaddr}",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "󰖪",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "disk": {
        "interval": 30,
        "format": "{percentage_used}%  ",
        "path": "/",
        "tooltip-format": "{used} de {total} usados ({percentage_used}%)",
        "on-click": "nemo"
    },
    "pulseaudio": {
        "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}<span color=\"#000000\">󰂯</span>",
        "format-bluetooth-muted": "󰟎 {icon}",
        "format-muted": " {format_source}",
        "format-icons": {
            "headphone": "󰋎  ",
            "hands-free": "",
            "headset": "󰋋 ",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
}
